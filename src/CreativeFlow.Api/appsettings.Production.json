{
  "Postgres": {
    "RunMigrationsOnStartup": false
  },
  "Authentication": {
    "PublicOrigin": "https://your-domain.example"
  },
  "Ai": {
    "AssetRoot": "/var/lib/creativeflow/assets",
    "RequireStorageMarker": true
  },
  "Skills": {
    "Root": "/var/lib/creativeflow/skills",
    "RequireStorageMarker": true,
    "SandboxEnabled": false,
    "OpenSandboxDomain": "opensandbox.example:8090"
  },
  "Workflow": {
    "Enabled": true
  },
  "Rerank": {
    "AllowedEndpoints": ["https://api.jina.ai/v1/rerank", "https://api.cohere.com/v2/rerank"]
  },
  "Knowledge": {
    "Enabled": true,
    "Qdrant": {
      "Endpoint": "http://127.0.0.1:6333"
    },
    "Quotas": {
      "MaxLibraries": 100,
      "MaxVersions": 100,
      "MaxDocuments": 128,
      "MaxDocumentBytes": 1048576,
      "MaxVersionBytes": 2097152,
      "MaxChunks": 8192,
      "MaxLibraryReservedBytes": 2147483648
    }
  }
}

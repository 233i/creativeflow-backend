{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "ConnectionString": "",
    "RunMigrationsOnStartup": false
  },
  "Redis": {
    "Configuration": "",
    "InstanceName": "creativeflow:"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "creativeflow",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "creativeflow.events",
    "QueueName": "creativeflow.events.api",
    "PrefetchCount": 16,
    "RoutingKeys": [ "device.#" ]
  },
  "Realtime": {
    "Backplane": "None"
  },
  "Mcp": {
    "AllowLoopbackHttp": false,
    "RequestTimeoutSeconds": 30,
    "MaxResponseBytes": 1048576
  },
  "Skills": {
    "SandboxEnabled": false,
    "MaxUploadBytes": 26214400,
    "MaxExtractedBytes": 104857600,
    "MaxEntries": 1000,
    "OpenSandboxDomain": "localhost:8090",
    "OpenSandboxApiKey": "",
    "OpenSandboxImage": "opensandbox/code-interpreter:v1.1.0",
    "RunnerTimeoutSeconds": 30,
    "RunnerMaxOutputBytes": 262144,
    "RunnerMaxPackageBytes": 26214400
  },
  "DeviceIdentity": {
    "SignalVersion": 1,
    "CoarseWindowHours": 24,
    "MaxCoarseFanout": 5,
    "CookieName": "creativeflow_did",
    "CookieMaxAgeDays": 730
  },
  "Authentication": {
    "PublicOrigin": "http://localhost:5298",
    "SessionCookieName": "creativeflow_session",
    "SessionMaxAgeDays": 30,
    "OAuthTransactionMinutes": 10,
    "GitHub": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Scope": "read:user user:email"
    }
  },
  "Admin": {
    "DefaultUsername": "admin",
    "DefaultPassword": "",
    "SessionCookieName": "creativeflow_admin_session",
    "SessionMaxAgeHours": 12
  },
  "Ai": {
    "MaxAssetBytes": 536870912,
    "AssetWriteTimeoutSeconds": 300,
    "RequestTimeoutSeconds": 1200,
    "SignedMediaUrlLifetimeMinutes": 60
  },
  "ExternalWorkflowApi": {
    "Enabled": true,
    "ApiKeyHashSecret": "",
    "MaxImageBytes": 20971520,
    "MaxImagePixels": 40000000,
    "MaxImageDimension": 16384,
    "MaxQueuedRunsPerWorkflow": 100,
    "GlobalConcurrency": 4,
    "DefaultWorkflowConcurrency": 2,
    "UploadedAssetLifetimeHours": 24,
    "CreateRunPermitLimitPerMinute": 30,
    "ImageUploadPermitLimitPerMinute": 30,
    "StatusPermitLimitPerMinute": 300
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}

{
  "Knowledge": {
    "Enabled": true,
    "Quotas": {
      "MaxLibraries": 20,
      "MaxVersions": 20,
      "MaxDocuments": 32,
      "MaxDocumentBytes": 262144,
      "MaxVersionBytes": 524288,
      "MaxChunks": 1024,
      "MaxLibraryReservedBytes": 67108864
    }
  },
  "Workflow": {
    "Enabled": true,
    "HttpRequests": {
      "Enabled": true,
      "AllowedEndpoints": ["https://*", "http://127.0.0.1:18599/query"]
    },
    "AllowedEndpoints": [
      "http://127.0.0.1:1234/v1/chat/completions",
      "http://localhost:1234/v1/chat/completions"
    ]
  },
  "Rerank": {
    "AllowedEndpoints": ["http://127.0.0.1:1234/v1/rerank", "http://localhost:1234/v1/rerank",
      "https://api.jina.ai/v1/rerank", "https://api.cohere.com/v2/rerank"]
  },
  "Embedding": {
    "AllowedEndpoints": [
      "http://127.0.0.1:1234/v1/embeddings",
      "http://localhost:1234/v1/embeddings",
      "http://127.0.0.1:1234/v1/models",
      "http://localhost:1234/v1/models"
    ]
  },
  "RabbitMq": {
    "HostName": "localhost"
  },
  "DeviceIdentity": {
    "Pepper": "REPLACE_WITH_LOCAL_DEVICE_PEPPER"
  },
  "Authentication": {
    "PublicOrigin": "http://localhost:5298"
  },
  "Admin": {
    "DefaultPassword": ""
  },
  "Mcp": {
    "AllowLoopbackHttp": true
  },
  "Skills": {
    "Root": "./storage/skills",
    "RequireStorageMarker": false,
    "OpenSandboxDomain": "localhost:8090"
  },
  "Ai": {
    "EncryptionKey": "REPLACE_WITH_LOCAL_AI_ENCRYPTION_KEY",
    "AssetRoot": "./storage/assets",
    "RequireStorageMarker": false
  }
}

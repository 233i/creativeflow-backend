<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 发布入口锁定包括 MAF 在内的完整依赖图。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- ASP.NET Core MVC Controllers 在 .NET 10 中不支持 Native AOT。 -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <RootNamespace>CreativeFlow.Api</RootNamespace>
    <!-- 开发专用，正式环境不自动加载 User Secrets。 -->
    <UserSecretsId>CreativeFlow.Api</UserSecretsId>
  </PropertyGroup>

  <!-- 测试宿主复用真实 JSON 元数据，避免另造与生产不同的序列化配置。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="CreativeFlow.UnitTests" />
  </ItemGroup>

  <!-- 私有配置仅从运行环境注入，不能被 SDK 的默认 JSON Content 规则带进构建或发布包。 -->
  <ItemGroup>
    <Content Update="appsettings.*.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CreativeFlow.Infrastructure/CreativeFlow.Infrastructure.csproj" />
    <ProjectReference Include="../CreativeFlow.Application/CreativeFlow.Application.csproj" />
    <ProjectReference Include="../CreativeFlow.Domain/CreativeFlow.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Abstractions" />
    <PackageReference Include="AGUI.Formatting" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <!--
    刻意不引用 Dapper 包。数据访问属于 CreativeFlow.Infrastructure，Dapper.AOT 源生成器也只在那里运行。
    该项目边界使交付层中的数据访问泄漏直接编译失败。
  -->

</Project>

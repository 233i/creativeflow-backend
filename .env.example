# Local-only development values. Copy to .env and replace every value.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
RABBITMQ_PASSWORD=REPLACE_WITH_LOCAL_RABBITMQ_PASSWORD
# Optional: needed only with the sandbox Compose profile. Match config.local.toml.
OPENSANDBOX_API_KEY=
DEVICE_PEPPER=REPLACE_WITH_LOCAL_DEVICE_PEPPER
# Must decode to exactly 32 bytes: openssl rand -base64 32 (not hex).
AI_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
PUBLIC_ORIGIN=http://localhost:5298
SKILLS_SANDBOX_ENABLED=false
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional host ports. Container-to-container ports remain unchanged.
# If you change these, update host-run API/frontend settings to match.
API_PORT=5298
POSTGRES_PORT=5432
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
OPENSANDBOX_PORT=8090
# Use distinct project and image names for parallel isolated installations.
COMPOSE_PROJECT_NAME=creativeflow
API_IMAGE=creativeflow/api:dev
# Optional build-only Alpine package mirror; keep APK signature checks enabled.
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine

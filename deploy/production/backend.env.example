# Production template only. Inject this through a secret store or a protected
# environment file; ASP.NET Core does not read .env files automatically.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5298
Authentication__PublicOrigin=https://your-domain.example
Postgres__ConnectionString=Host=postgres.example;Port=5432;Database=creativeflow;Username=REPLACE_WITH_PROD_USER;Password=REPLACE_WITH_PROD_PASSWORD
Postgres__RunMigrationsOnStartup=false
Redis__Configuration=redis.example:6379,password=REPLACE_WITH_PROD_REDIS_PASSWORD
RabbitMq__HostName=rabbitmq.example
RabbitMq__Port=5672
RabbitMq__UserName=REPLACE_WITH_PROD_RABBIT_USER
RabbitMq__Password=REPLACE_WITH_PROD_RABBIT_PASSWORD
DeviceIdentity__Pepper=REPLACE_WITH_LONG_RANDOM_PEPPER
Ai__EncryptionKey=REPLACE_WITH_32_BYTE_BASE64_KEY
Admin__DefaultUsername=admin
Admin__DefaultPassword=REPLACE_WITH_PRODUCTION_BOOTSTRAP_PASSWORD
Ai__AssetRoot=/var/lib/creativeflow/assets
Ai__RequireStorageMarker=true
Skills__Root=/var/lib/creativeflow/skills
Skills__RequireStorageMarker=true
Skills__SandboxEnabled=false
Skills__OpenSandboxDomain=opensandbox.example:8090
Skills__OpenSandboxApiKey=REPLACE_WITH_PRODUCTION_OPENSANDBOX_KEY
# Enable only after the loopback Qdrant setup in docs/knowledge.md is ready.
Knowledge__Enabled=false
Knowledge__Qdrant__Endpoint=http://127.0.0.1:6333
Knowledge__Qdrant__Namespace=cfprod_main
Knowledge__Qdrant__ApiKey=REPLACE_WITH_PRODUCTION_QDRANT_KEY
# Add only the exact model/API endpoints required by this deployment:
# Workflow__AllowedEndpoints__0=https://provider.example/v1/chat/completions
# Embedding__AllowedEndpoints__0=https://provider.example/v1/embeddings
